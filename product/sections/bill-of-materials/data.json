{
  "_meta": {
    "models": {
      "BillOfMaterials": "A hierarchical breakdown of materials, components, and packaging required to manufacture a specific product or style. BOMs have types (Design, Manufacturing, Sourcing) and configurable subtypes.",
      "BomLineItem": "A single entry in a BOM representing a material, component, sub-assembly, or packaging element. Line items are hierarchical — they can contain child line items to represent nested sub-assemblies.",
      "BomVersion": "A historical snapshot of a BOM at a point in time, capturing the full line item tree, costs, and metadata. Used for version comparison and audit trails.",
      "CostBreakdown": "The detailed cost structure for a BOM or line item, including material cost, labor, overhead, shipping, and duties. Supports multiple cost scenarios (best/worst/expected).",
      "ApprovalStep": "A single step in an approval workflow for a BOM. Each step has an assignee, status, and optional comments. Steps can be sequential or parallel.",
      "BomType": "A configurable classification for BOMs. Core types (Design, Manufacturing, Sourcing) ship as defaults; tenants can modify or add custom types and subtypes.",
      "Material": "A raw material, component, or sub-assembly available in the material library. Materials have suppliers, costs, specifications, and can be added to any BOM as line items."
    },
    "relationships": [
      "BillOfMaterials belongs to a Product or Style",
      "BillOfMaterials has many BomLineItem (hierarchical tree)",
      "BomLineItem can have many child BomLineItem (sub-assemblies)",
      "BomLineItem references a Material from the material library",
      "BomLineItem can have multiple supplier cost options",
      "BillOfMaterials has many BomVersion (version history)",
      "BillOfMaterials has many ApprovalStep (approval workflow)",
      "BillOfMaterials has one CostBreakdown (rollup)",
      "BomLineItem has one CostBreakdown (per-item)",
      "Material has many Supplier (via supplierCosts)"
    ]
  },

