{
  "_meta": {
    "models": {
      "currentUser": "The logged-in user viewing the dashboard. Their role determines which filters they can see and use.",
      "funnelMetrics": "Aggregated counts for the sales funnel, derived from Lead and Call entities. Each metric includes a drilldownFilter for navigating to the Leads section with the correct filters applied.",
      "dropReasonStats": "Breakdown of why leads were lost, aggregated from leads with a lost status. Includes an 'Unknown' bucket for leads where no drop reason was captured.",
      "filterOptions": "Available filter values with visibility metadata. Each filter specifies who can see it (all users vs founder_only) and its default selection."
    },
    "relationships": [
      "FunnelMetrics are aggregated from Lead and Call entities for the selected date range and filters",
      "DropReasonStats are aggregated from Leads where stage = 'Lost', grouped by DropReason",
      "FilterOptions.bds lists Users with role 'BD'",
      "FilterOptions.sources, pipelines, and stages come from their respective entities"
    ]
  },
  "_definitions": {
    "_note": "Internal alignment: how each metric is calculated. Not for end-user display.",
    "callsMade": "Count of Call records where call.createdAt falls within selected date range",
    "connected": "Count of Calls where call.outcome = 'connected' (i.e., lead picked up and conversation happened)",
    "connectRate": "connected / callsMade * 100",
    "hotLeads": "Count of Leads where current stage.id = 'stage-hot' AND lead.stageChangedAt falls within selected date range",
    "won": "Count of Leads where current stage.id = 'stage-won' AND lead.stageChangedAt falls within selected date range",
    "lost": "Count of Leads where current stage.id = 'stage-lost' AND lead.stageChangedAt falls within selected date range",
    "dateFields": {
      "callMetrics": "call.createdAt — when the call was made",
      "stageMetrics": "lead.stageChangedAt — when the lead entered that stage"
    }
  },
