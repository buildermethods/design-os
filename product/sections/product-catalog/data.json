  "_meta": {
    "models": {
      "Product": "A top-level item being brought to market. In fashion this might be a 'Theme' or 'Collection', in food a 'Product Line'. Products contain styles/variants and aggregate specifications, documents, and BOM data.",
      "Style": "A specific variant of a product — a colorway in fashion, a flavor in food, a formulation in chemicals. Styles inherit from their parent product but carry their own attributes.",
      "Season": "A time-bound grouping of products (e.g., FW25, SS26). Some verticals may use different terminology (Release, Batch, Campaign) but the concept is a temporal container for products.",
      "Attribute": "A configurable field on any entity. Tenants define their own attribute schemas per product type.",
      "Document": "A file attachment associated with a product or style — tech packs, images, lab reports, certificates, etc."
    },
