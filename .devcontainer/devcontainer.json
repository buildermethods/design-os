{
  "name": "design-os",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "containerEnv": {
    "VITE_HOST": "::"
  },
  "postCreateCommand": "npm install",
  "appPort": [3000],
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    }
  }
}
